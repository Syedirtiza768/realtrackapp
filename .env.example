PORT=4191

# ── AWS t3.medium (2 vCPU, 4 GB RAM) — local Nest / PM2 on same host ──
NODE_OPTIONS=--max-old-space-size=1536 --dns-result-order=ipv4first --no-network-family-autoselection
DB_POOL_MAX=10
DB_POOL_MIN=2
PIPELINE_AI_CONCURRENCY=3
PIPELINE_AI_BATCH_SIZE=6
PIPELINE_LOCALIZATION_CONCURRENCY=3
PIPELINE_IMAGE_CONCURRENCY=3
PIPELINE_CATEGORY_CONCURRENCY=2
PIPELINE_CATEGORY_AI_MODEL=google/gemini-2.5-flash
PIPELINE_VIN_BATCH_CONCURRENCY=3
PIPELINE_MVL_IMPORT_CONCURRENCY=8
PIPELINE_IMAGE_SKU_CONCURRENCY=2
CATALOG_IMPORT_EBAY_BROWSE_CONCURRENCY=2

# --- Catalog pricing stage (scripts/price-enrich-catalog.mjs) ---
# Comparables come from the eBay Browse API (ACTIVE listings; no sold-listing
# access on a buy.browse grant). See docs/operations/CATALOG_PIPELINE.md.
# PRICING_CURRENCY=USD
# PRICING_MARKETPLACE=EBAY_US
# PRICING_MEDIAN_MULTIPLIER=0.97   # recommended price = median comparable x this
# PRICING_MSRP_MULTIPLIER=0.9      # fallback when no comparables exist
# PRICING_MIN_COMPARABLES=3        # below this a row goes to manual_pricing_review
# PRICING_MAX_DISPERSION=6         # high/low ratio above this -> manual_pricing_review
# PRICING_MIN_COMP_PRICE=1
# PRICING_MIN_SELLER_FEEDBACK_PERCENT=95
# PRICING_MIN_SELLER_FEEDBACK_SCORE=50
# PRICING_CONCURRENCY=4
# PRICING_INPUT=/app/output/ebay-pipeline/napa_ebay_shopify_listings.complete-fitment-enriched.csv
# PRICING_OUTPUT_DIR=/app/output/ebay-pipeline
# PRICING_READY_CSV=/app/output/ebay-pipeline/napa_ebay_shopify_listings.complete.ebay-listings-ready.csv
# Web-search pricing (scripts/price-web-research.mjs) — uses OPENAI_API_KEY / OPENAI_BASE_URL (OpenRouter)
# PRICING_WEB_MODEL=openai/gpt-5.6-luna
# PRICING_WEB_MAX_RESULTS=6
# PRICING_WEB_REASONING=low
# PRICING_WEB_CONCURRENCY=3
# PRICING_WEB_MAX_COST_USD=25
CATALOG_IMPORT_IMAGE_SKU_CONCURRENCY=2

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=global321
DB_NAME=listingpro
DB_SYNC=true

LISTINGS_FOLDER_PATH=../files/_same_structure_as_B20_eBay_Verified_2-Oct

# Comma-separated allowed origins (defaults to localhost:5173 + app.omnicoreholding.com)
# CORS_ORIGIN=https://app.omnicoreholding.com

# --- eBay multi-store integrations ---
# EBAY_ENV=sandbox
# EBAY_LISTING_API_MODE=trading
# Standard new single-item listings default to Trading API for Seller Hub editing.
# Set this to inventory only when explicitly choosing Inventory API on that path.
# Variation-family item groups and existing Inventory offers keep their own flows.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_REDIRECT_URI=<OAuth-enabled eBay RuName; not the callback URL>
# EBAY_WEBHOOK_SECRET= # shared secret for signed B&I enforcement notifications
# EBAY_WEBHOOK_SECRET= # shared secret for signed B&I enforcement notifications
# PRIMEMOTIVE_SALES_WEBHOOK_SECRET= # HMAC secret for external Primemotive sale events
# MOTOARK_ORDER_WEBHOOK_SECRET= # separate HMAC key for order lifecycle events
# PRIMEMOTIVE_LISTING_WEBHOOK_ORGANIZATION_ID= # required organization scope for outbound callbacks
# PRIMEMOTIVE_LISTING_WEBHOOK_URL= # HTTPS callback for listing.added/updated/removed events
# PRIMEMOTIVE_LISTING_WEBHOOK_SECRET= # HMAC secret for outbound listing-change callbacks
# PRIMEMOTIVE_SIMULATION_ENABLED=false # opt-in; changes only synthetic DB mirror rows
# PRIMEMOTIVE_SIMULATION_ORGANIZATION_ID= # UUID used by the simulator and dummy seed command
PUBLISHED_LISTINGS_SYNC_STALE_AFTER_HOURS=24 # Use 192 when the mirror full sync runs weekly
# EBAY_RU_NAME=
# EBAY_SCOPES=
# EBAY_API_BASE_URL=
# EBAY_OAUTH_BASE_URL=
# Auto-provisioned inventory location when seller has none on eBay:
# EBAY_DEFAULT_MERCHANT_LOCATION_KEY=AE_Dubai
# EBAY_DEFAULT_INVENTORY_ADDRESS_LINE1=Primary Warehouse
# EBAY_DEFAULT_INVENTORY_CITY=Houston
# EBAY_DEFAULT_INVENTORY_STATE=TX
# EBAY_DEFAULT_INVENTORY_POSTAL_CODE=77001
# EBAY_DEFAULT_INVENTORY_COUNTRY=US
# EBAY_DAILY_PUBLISH_TARGET_LIMIT=5000
# Temporary operator-led B&I publish bypass; keep false unless explicitly enabled.
# BUSINESS_INDUSTRIAL_ALLOW_UNAPPROVED_PUBLISH=false
# BUSINESS_INDUSTRIAL_DEFAULT_DISPATCH_LOCATION=United States
# BUSINESS_INDUSTRIAL_DEFAULT_SHIPPING_COVERAGE=United States
# FRONTEND_BASE_URL=http://localhost:3911
# Production default when unset: https://app.omnicoreholding.com
# TOKEN_ENCRYPTION_KEY=
# TOKEN_ENCRYPTION_KMS_KEY_ID=
# REDIS_URL=redis://localhost:6379
# EBAY_INTEGRATIONS_REDIS=redis://localhost:6379
# BULLMQ_PREFIX=realtrack
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL_DEFAULT=openai/gpt-4.1-mini
# OPENAI_MODEL_FLAGSHIP=google/gemini-2.5-flash
# OPENAI_MODEL_BULK=deepseek/deepseek-chat-v3-0324
# Single-listing OEM text lookup (/listings/new Fetch details) — benchmark pick: best cost/credibility
# OPENAI_MODEL_TEXT=openai/gpt-4o-mini
# OPENAI_MODEL_ESCALATION=google/gemini-2.5-flash
# OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
# Vision fallback when OEM lookup fails (requires label + overall photos)
# OPENAI_VISION_MODEL=google/gemini-2.5-flash
# OPENAI_LISTING_MODEL=openai/gpt-4.1-mini
# OPENAI_MODEL_FLAGSHIP_MIN_PRICE=200
# AI_LOW_VALUE_MAX_PRICE=50
# OPENAI_VISION_DETAIL=auto
# AI_FITMENT_MIN_ROWS=5
# AI_AUTO_APPROVE_MIN_SCORE=85
# AI_ROUTING_POLICY_PATH=config/ai-routing-policy.json
# AI_OPTIMIZER_ENABLED=false
# AI_OPTIMIZER_CANARY_PERCENT=10
# AI_LEARNING_MIN_SAMPLES=20
# AI_PROMPT_VERSION=enrichment-v2-compact
# AI_TAXONOMY_VALIDATION_ENABLED=false
# AI_RUN_MODE=default
# OPENAI_LISTING_ENRICHMENT_ENABLED=false

# Pipeline output: mirror PicURL images to S3 (default true). Set false to keep original URLs.
# PIPELINE_MIRROR_IMAGES=true
# Skip per-row eBay MVL re-validation on catalog import (default true — set false after `npm run mvl:import`).
# PIPELINE_SKIP_MVL_ON_IMPORT=true

# --- eBay Master Vehicle List (official spreadsheet reference data) ---
# EBAY_MVL_DATA_DIR=../drive-download-20260706T171856Z-3-001
# EBAY_MVL_WORKBOOK_PASSWORD=VehicleList
# MVL-driven fitment expansion (default hybrid — AI listing copy only; fitment from local MVL DB)
# FITMENT_EXPANSION_MODE=hybrid
# FITMENT_AI_INTERCHANGE=auto
# FITMENT_MIN_MVL_ROWS=5
# FITMENT_SIBLING_EXPANSION=conservative
# FITMENT_MVL_REQUIRED=true
# Max compatibility rows per listing in export XLSX (default 80).
# PIPELINE_EXPORT_MAX_FITMENT_ROWS=80
# Max fitment rows in listing description HTML (default 30).
# PIPELINE_DESC_MAX_FITMENT_ROWS=30

# --- SellerPundit API integration ---
# SELLERPUNDIT_API_BASE_URL=https://authentication.sellerpundit.com/api/v1
# SELLERPUNDIT_MARKETPLACES_URL=https://marketplaces.sellerpundit.com
# SELLERPUNDIT_EMAIL=
# SELLERPUNDIT_PASSWORD=
# SELLERPUNDIT_ENVIRONMENT=production
# SELLERPUNDIT_DEFAULT_MARKETPLACE_ID=EBAY_MOTORS_US
# SELLERPUNDIT_POLICY_SYNC_MAX_AGE_HOURS=24
# Publish to PartsBazar360 (push channel). Feature is off until the key is set;
# it must equal REALTRACK_PUSH_API_KEY on partsbazar360.com. Secret.
# PARTSBAZAR360_API_KEY=
# PARTSBAZAR360_API_URL=https://partsbazar360.com/api
# Fashion admin seed (run npm run seed:fashion-admin explicitly)
# FASHION_SEED_ADMIN_EMAIL=
# FASHION_SEED_ADMIN_PASSWORD=
# FASHION_SEED_ADMIN_NAME=Fashion Admin
# FASHION_SEED_ADMIN_ORGANIZATION_NAME=Fashion workspace
# Fashion photo identification (OpenRouter). Leave unset to use the Jev-selected
# defaults: google/gemini-3.1-flash-lite, falling back to google/gemma-4-31b-it.
# FASHION_AI_FALLBACK_MODEL=none disables the fallback. See docs/decisions.md (2026-10-07).
# FASHION_AI_MODEL=
# FASHION_AI_FALLBACK_MODEL=
